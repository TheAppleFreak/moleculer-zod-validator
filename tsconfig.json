{
    "compilerOptions": {
        "target": "es2025",
        "module": "commonjs",
        "moduleResolution": "node10",
        "ignoreDeprecations": "6.0",
        "allowJs": false,
        "declaration": true,
        "sourceMap": false,
        "strict": true,
        "noImplicitAny": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "types": ["node"],
		"outDir": "./build",
		"rootDir": "./src"
    },
	"include": [
		"src/**/*.ts"
    ],
	"exclude": [
		"node_modules/**"
	]
}